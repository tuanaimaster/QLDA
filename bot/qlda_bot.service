[Unit]
Description=QLDA Telegram Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/QLDABot/bot
EnvironmentFile=/root/QLDABot/bot/.env
ExecStart=/root/QLDABot/bot/.venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=append:/root/QLDABot/bot/logs/bot.log
StandardError=append:/root/QLDABot/bot/logs/bot.log

[Install]
WantedBy=multi-user.target
